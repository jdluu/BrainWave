# --- Required ---
# Groq (https://console.groq.com/keys) — free tier available
GROQ_API_KEY=""

# Clerk (https://dashboard.clerk.com) — free tier available
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Turso hosted SQLite (https://turso.tech) — free tier: 100 DBs, 5GB
# Run: turso db create brainwave && turso db tokens create brainwave
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Optional ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Local SQLite fallback (used if TURSO_DATABASE_URL is empty)
DATABASE_URL="file:./db/custom.db"

# Created by Prisma during db push / migrate. Do not commit.
.env
